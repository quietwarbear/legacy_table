From 3611383563ed07c29709b7bc4134de013ee67db3 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sat, 30 May 2026 15:38:53 -0700
Subject: [PATCH] fix(build): also export DioExceptionType from dio import

The previous import used 'show DioException', which scoped only the
exception class and hid the DioExceptionType enum we compare against
in the if-chain. Adding DioExceptionType to the show list.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 mobile/lib/views/login_screen.dart | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mobile/lib/views/login_screen.dart b/mobile/lib/views/login_screen.dart
index a34aec6..2a8a6d4 100644
--- a/mobile/lib/views/login_screen.dart
+++ b/mobile/lib/views/login_screen.dart
@@ -1,4 +1,4 @@
-import 'package:dio/dio.dart' show DioException;
+import 'package:dio/dio.dart' show DioException, DioExceptionType;
 import 'package:flutter/material.dart';
 import 'package:flutter/foundation.dart';
 import 'package:flutter/services.dart' show PlatformException;
-- 
2.34.1

