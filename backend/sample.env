# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=htrecipes

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production

# Kindred recipe import reconciliation (server-side only, at least 32 bytes)
RECIPE_IMPORT_HASH_KEY=

# CORS Configuration (comma-separated, optional; default: *)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe price IDs. Unset falls back to the original "Ubuntu Market" account
# prices; set all four to move Legacy Table to another Stripe account. They
# must belong to the same account as STRIPE_SECRET_KEY — checkout verifies the
# amount and interval and fails loudly if they do not match.
STRIPE_PRICE_HERITAGE_MONTHLY=
STRIPE_PRICE_HERITAGE_ANNUAL=
STRIPE_PRICE_LEGACY_MONTHLY=
STRIPE_PRICE_LEGACY_ANNUAL=

# RevenueCat Webhook
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here

# RevenueCat Stripe analytics forwarding (optional). Public API key of the
# Stripe app connected to this project in the RevenueCat dashboard
# (Project settings -> Apps -> Stripe). When set, new web Stripe
# subscriptions are reported to RevenueCat so web + app-store revenue share
# one analytics dashboard. Absent = feature off. Analytics only; entitlement
# granting is unaffected.
REVENUECAT_STRIPE_PUBLIC_KEY=

# Owner sales alerts (email). Comma-separated recipients who get an email on
# every new subscriber, trial, cancellation, billing issue and gift purchase
# across Apple, Google Play and Stripe web. Absent = feature off. Requires
# RESEND_API_KEY. Set OWNER_ALERT_RENEWALS=1 to also hear about renewals.
OWNER_ALERT_EMAILS=
OWNER_ALERT_RENEWALS=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Legacy Table <table@legacytable.app>"

# GA4 server-side analytics (Measurement Protocol). Absent = feature off:
# ga4.py no-ops and nothing in the request path changes. Values come from
# GA4 Admin -> Data collection and modification -> Data streams -> the
# Legacy Table stream (Measurement ID at top right; API secret under
# "Measurement Protocol API secrets"). Store the secret in Bitwarden.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
APP_NAME=legacy_table

# Recipe media storage (Railway bucket "legacy-table-voice", S3 compatible)
# — voice keepsake audio under voice/, recipe photos under photos/. On
# Railway these are reference variables to the bucket's credentials.
# Absent = audio and photos are embedded in recipe documents (dev fallback);
# never leave these unset in production — embedded media is what caused the
# 2026-09-16 recipes outage. Photo URLs in API responses are built from
# PUBLIC_API_BASE (defaults to https://api.legacytable.app).
VOICE_BUCKET=
VOICE_BUCKET_ENDPOINT=
VOICE_BUCKET_REGION=auto
VOICE_BUCKET_ACCESS_KEY_ID=
VOICE_BUCKET_SECRET_ACCESS_KEY=
